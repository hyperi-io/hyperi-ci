{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "app_name",
    "metrics_port",
    "health",
    "env_prefix",
    "metric_prefix"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 4 },
    "app_name": { "type": "string" },
    "description": { "type": "string", "default": "" },
    "metrics_port": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "health": { "$ref": "#/$defs/HealthContract" },
    "env_prefix": { "type": "string" },
    "metric_prefix": { "type": "string" },
    "image_registry": { "type": "string", "default": "" },
    "config_schema": {
      "anyOf": [{ "$ref": "#/$defs/ConfigSchemaNode" }, { "type": "null" }]
    }
  },
  "$defs": {
    "HealthContract": {
      "type": "object",
      "properties": {
        "liveness_path": { "type": "string" },
        "readiness_path": { "type": "string" },
        "metrics_path": { "type": "string" }
      },
      "required": ["liveness_path", "readiness_path", "metrics_path"]
    },
    "ConfigSchemaNode": {
      "properties": {
        "x-scalo-dial": { "type": "string", "enum": ["big", "small"] }
      },
      "additionalProperties": { "$ref": "#/$defs/ConfigSchemaNode" },
      "items": { "$ref": "#/$defs/ConfigSchemaNode" }
    }
  }
}
